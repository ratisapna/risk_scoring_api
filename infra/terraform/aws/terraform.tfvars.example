# Copy this to terraform.tfvars and fill in your values
# IMPORTANT: terraform.tfvars is in .gitignore - never commit secrets!

aws_region = "us-east-1"

db_name     = "risk_scoring_db"
db_username = "risk_admin"
db_password = "ChangeMe!SecurePassword123"  # Use a strong password!

# Your SSH public key (for EC2 access)
# Generate with: ssh-keygen -t ed25519
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your-key-here"

# Restrict SSH to your IP for security (e.g., "203.0.113.0/32")
allowed_ssh_cidr = ["0.0.0.0/0"]  # Change to your IP!

github_repo = "https://github.com/ratisapna/risk_scoring_api.git"
